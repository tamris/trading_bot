# ==========================================
# MetaTrader 5 (MT5) Configuration
# ==========================================
MT5_LOGIN=12345678
MT5_PASSWORD=your_demo_password_here
MT5_SERVER=Exness-MT5Trial
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_MOCK_MODE=False

# ==========================================
# Exness Direct Cloud API Configuration (For Linux / Railway / Cloud)
# ==========================================
TRADING_BACKEND=MT5
EXNESS_API_KEY=your_exness_api_key_here
EXNESS_API_SECRET=your_exness_private_key_hex_here
EXNESS_ACCOUNT_ID=your_account_id_here
EXNESS_GATEWAY_URL=https://api.exness-api.com

# ==========================================
# Google Gemini AI Configuration
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ==========================================
# Telegram Bot Configuration
# ==========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ==========================================
# Trading & Risk Parameters
# ==========================================
SYMBOLS=BTCUSDm,XAUUSDm,EURUSDm,USDJPYm
TIMEFRAME_MACRO=H1
TIMEFRAME_ENTRY=M15
RISK_PERCENT=1.0
MAX_DAILY_DRAWDOWN_PERCENT=3.0
MAX_OPEN_POSITIONS_PER_SYMBOL=2
MAX_OPEN_POSITIONS_CRYPTO_ACTIVE_SESSION=1
MAX_OPEN_POSITIONS_CRYPTO_WEEKEND=2
MAX_TOTAL_OPEN_POSITIONS=3
NEWS_PROTECTION_MINUTES=15
MIN_CONFLUENCE_SCORE=85
SYMBOL_COOLDOWN_MINUTES=45
ADX_MIN_THRESHOLD=20.0

# Professional Risk & Session Parameters
PARTIAL_TP_ENABLED=True
SESSION_FILTER_ENABLED=True
ATR_SL_MULTIPLIER=1.5
ATR_TP_MULTIPLIER=3.0
BEP_TRIGGER_MULTIPLIER=1.5
